# Exemplo de variaveis de ambiente do Rastreador de Precos (MVP).
# Copie este arquivo para .env e preencha com os valores reais.
# O arquivo .env NUNCA deve ser commitado (ver .gitignore).
# Aqui documentamos apenas os NOMES das 8 chaves esperadas, com valores vazios.

# --- Mercado Livre (OAuth 2.0) ---
ML_CLIENT_ID=
ML_CLIENT_SECRET=
ML_REDIRECT_URI=
ML_ACCESS_TOKEN=
ML_REFRESH_TOKEN=

# --- Notificacao por e-mail (SMTP / Gmail com Senha de App) ---
EMAIL_REMETENTE=
EMAIL_SENHA_APP=
EMAIL_DESTINATARIO=
